{
  "meta": {
    "id": "toy_inverted_index_benchmark",
    "description": "A benchmark of a toy inverted index for testing purposes."
  },
  "dataset": {
    "id": "toy",
    "query_set": "keywords"
  },
  "runs": [
    {
      "id": "example",
      "index": {
        "physical_type": "positional_index",
        "structure": "skip_list",
        "ordering": "docid_sorted",
        "dictionary_type": "hash_table"
      },
      "analysis": {
        "character_filters": [
          {
            "type": "ponctuation",
            "replace": " "
          }
        ],
        "tokenizer": {
          "type": "space"
        },
        "token_filters": [
          {
            "type": "lowercase"
          }
        ]
      },
      "retrieval": {
        "type": "boolean"
      }
    }
  ],
  "evaluation": {
    "metrics": [
      "precision",
      "recall",
      "f1"
    ]
  }
}