{
  "meta": { 
    "id": "toy_inverted_index_benchmark",
    "description": "A benchmark of a toy inverted index for testing purposes."
  },

  "dataset": {
    "id": "toy",
    "query_set": "keywords"
  },

  "indexes": [
    {
            "character_filters" :[
                {
                    "type" : "ponctuation",
                    "replace" : " "
                }
            ],
            "tokenizer" : [
                {
                    "type" : "space"
                }
            ],
            "token_filters" : [
                {
                    "type" : "lowercase"
                }
            ]
        }

  ],

  

  "retrieval_model": {
    "type": "boolean"
  }
  ,
  "evaluation": {
    "metrics": [
      "binary_correctness",
    ]
  }
}



