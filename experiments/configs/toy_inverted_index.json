{
  "meta": {
    "id": "toy_inverted_index_benchmark",
    "description": "A benchmark of a toy inverted index for testing purposes."
  },
  "dataset": {
    "id": "toy"
  },
  "runs": [
    {
      "id": "example",
      "index": {
        "structure": "inverted"
      },
      "analysis": {
        "character_filters": [
          {
            "type": "ponctuation",
            "replace": " "
          }
        ],
        "tokenizer": {
          "type": "space"
        },
        "token_filters": [
          {
            "type": "lowercase"
          }
        ]
      },
      "retrieval": {
        "type": "boolean"
      }
    }
  ]
}
